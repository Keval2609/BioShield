# IBM Granite LLM Configuration
# Accepts any OpenAI-compatible endpoint (e.g. watsonx.ai, Ollama, vLLM, or LMStudio)
GRANITE_MODEL=ibm/granite-3-8b-instruct
GRANITE_BASE_URL=https://api.example.com/v1
GRANITE_API_KEY=your_granite_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG & Retrieval Parameters
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Storage & Data Paths
CHROMA_PERSIST_DIR=./chroma_db
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
